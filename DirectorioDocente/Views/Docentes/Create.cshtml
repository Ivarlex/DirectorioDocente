@model DirectorioDocente.Models.Docente

@{
    ViewData["Title"] = "Nuevo Docente";
}

<div class="max-w-xl mx-auto bg-white border border-[#DCE4ED] rounded-lg shadow-xs p-5 sm:p-6">
    <div class="mb-5 pb-3 border-b border-[#DCE4ED]">
        <h2 class="text-lg font-bold text-[#172B4D]">Alta Administrativa de Docente</h2>
        <p class="text-xs text-[#64748B]">Registra los datos institucionales del profesor. El docente podrá complementar su perfil y fotografía posteriormente.</p>
    </div>

    <form asp-action="Create" method="post" class="space-y-3.5 text-xs">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="ClaveDocente" class="block font-bold text-[#172B4D] mb-1">Matrícula / Clave Docente</label>
            <input asp-for="ClaveDocente" placeholder="Ej. DOC-101" class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="ClaveDocente" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="NombreCompleto" class="block font-bold text-[#172B4D] mb-1">Nombre Completo</label>
            <input asp-for="NombreCompleto" autocomplete="name" placeholder="Nombre(s) y Apellidos" class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="NombreCompleto" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="CorreoInstitucional" class="block font-bold text-[#172B4D] mb-1">Correo Institucional</label>
            <input asp-for="CorreoInstitucional" type="email" autocomplete="email" placeholder="docente@upvm.edu.mx" class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="CorreoInstitucional" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="Telefono" class="block font-bold text-[#172B4D] mb-1">Teléfono de Contacto</label>
            <input asp-for="Telefono" type="tel" autocomplete="tel" placeholder="10 dígitos" class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="Telefono" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="TipoContrato" class="block font-bold text-[#172B4D] mb-1">Tipo de Contrato</label>
            <select asp-for="TipoContrato" class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none">
                <option value="Tiempo Completo">Tiempo Completo</option>
                <option value="Asignatura">Asignatura</option>
            </select>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-[#DCE4ED]">
            <a asp-action="Index" class="px-4 py-2 text-xs font-semibold text-[#64748B] hover:text-[#172B4D] transition">Cancelar</a>
            <button type="submit" class="px-4 py-2 bg-[#285EA8] hover:bg-[#172B4D] text-white text-xs font-bold rounded-md shadow-xs transition flex items-center gap-1.5">
                <icon name="check" class="w-3.5 h-3.5 text-white" />
                <span>Registrar Docente</span>
            </button>
        </div>
    </form>
</div>