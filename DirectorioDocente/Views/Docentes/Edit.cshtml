@model DirectorioDocente.Models.Docente

@{
    ViewData["Title"] = "Editar Docente";
}

<div class="max-w-xl mx-auto bg-white border border-[#DCE4ED] rounded-lg shadow-xs p-5 sm:p-6">
    <div class="mb-5 pb-3 border-b border-[#DCE4ED] flex items-center justify-between">
        <div class="flex items-center gap-2.5">
            <a asp-action="Index" class="p-1.5 rounded-md text-[#64748B] hover:text-[#172B4D] hover:bg-slate-100 transition" title="Volver al Directorio">
                <icon name="chevron-left" class="w-4 h-4" />
            </a>
            <div>
                <h2 class="text-lg font-bold text-[#172B4D]">Editar Información Administrativa</h2>
                <p class="text-xs text-[#64748B]">Actualiza los datos institucionales de <strong>@Model.NombreCompleto</strong></p>
            </div>
        </div>
    </div>

    <div class="p-3 bg-[#E9EFF6] rounded-md border border-[#DCE4ED] mb-4 text-xs text-[#172B4D] flex items-start gap-2">
        <icon name="notepad-text" class="w-4 h-4 text-[#285EA8] shrink-0 mt-0.5" />
        <p class="text-[11px] text-[#64748B]">
            La fotografía, cubículo, semblanza y grado académico son administrados libremente por el docente desde su propio perfil y no se sobreescriben aquí.
        </p>
    </div>

    <form id="formEditDocente" asp-action="Edit" method="post" class="space-y-3.5 text-xs">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="ClaveDocente" class="block font-bold text-[#172B4D] mb-1">Matrícula / Clave</label>
            <input asp-for="ClaveDocente"
                   placeholder="Ej. DOC-101"
                   class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="ClaveDocente" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="NombreCompleto" class="block font-bold text-[#172B4D] mb-1">Nombre Completo</label>
            <input asp-for="NombreCompleto"
                   autocomplete="name"
                   placeholder="Nombre(s) y Apellidos"
                   class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="NombreCompleto" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="CorreoInstitucional" class="block font-bold text-[#172B4D] mb-1">Correo Institucional</label>
            <input asp-for="CorreoInstitucional"
                   type="email"
                   autocomplete="email"
                   placeholder="docente@upvm.edu.mx"
                   class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="CorreoInstitucional" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="Telefono" class="block font-bold text-[#172B4D] mb-1">Teléfono</label>
            <input asp-for="Telefono"
                   type="tel"
                   autocomplete="tel"
                   placeholder="10 dígitos"
                   class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none" />
            <span asp-validation-for="Telefono" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
        </div>

        <div>
            <label asp-for="TipoContrato" class="block font-bold text-[#172B4D] mb-1">Tipo de Contrato</label>
            <select asp-for="TipoContrato"
                    class="w-full bg-slate-50 border border-[#DCE4ED] rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-[#285EA8] outline-none">
                <option value="Tiempo Completo">Tiempo Completo</option>
                <option value="Asignatura">Asignatura</option>
            </select>
        </div>

        <div class="flex items-center gap-2 pt-1">
            <input asp-for="Activo" type="checkbox" class="w-4 h-4 rounded-xs border-[#DCE4ED] accent-[#285EA8]" />
            <label asp-for="Activo" class="text-xs text-[#172B4D] font-medium">Docente activo en la plantilla del ciclo actual</label>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-[#DCE4ED]">
            <a asp-action="Index" class="px-4 py-2 text-xs font-semibold text-[#64748B] hover:text-[#172B4D] transition">
                Cancelar
            </a>
            <button type="submit" id="btnGuardarEdit" disabled
                    class="px-4 py-2 bg-[#285EA8] hover:bg-[#172B4D] text-white text-xs font-bold rounded-md shadow-xs transition flex items-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed">
                <icon name="check" class="w-3.5 h-3.5 text-white" />
                <span id="btnGuardarEditTexto">Guardar Cambios</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const camposEdit = ['ClaveDocente', 'NombreCompleto', 'CorreoInstitucional', 'Telefono', 'TipoContrato'];
        const valoresInicialesEdit = {};
        let activoInicial = false;

        function verificarCambiosEdit() {
            let haCambiado = false;
            for (const c of camposEdit) {
                const el = document.getElementById(c);
                if (el && el.value.trim() !== (valoresInicialesEdit[c] || '')) {
                    haCambiado = true;
                    break;
                }
            }

            const chkActivo = document.getElementById('Activo');
            if (chkActivo && chkActivo.checked !== activoInicial) {
                haCambiado = true;
            }

            const btn = document.getElementById('btnGuardarEdit');
            if (btn) {
                btn.disabled = !haCambiado;
                if (haCambiado) {
                    btn.classList.remove('opacity-40', 'cursor-not-allowed');
                } else {
                    btn.classList.add('opacity-40', 'cursor-not-allowed');
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            camposEdit.forEach(c => {
                const el = document.getElementById(c);
                if (el) valoresInicialesEdit[c] = el.value.trim();
            });

            const chkActivo = document.getElementById('Activo');
            if (chkActivo) activoInicial = chkActivo.checked;

            const form = document.getElementById('formEditDocente');
            if (form) {
                form.addEventListener('input', verificarCambiosEdit);
                form.addEventListener('change', verificarCambiosEdit);
                form.addEventListener('submit', () => {
                    const btn = document.getElementById('btnGuardarEdit');
                    const txt = document.getElementById('btnGuardarEditTexto');
                    if (btn) {
                        btn.disabled = true;
                        btn.classList.add('opacity-40', 'cursor-not-allowed');
                        if (txt) txt.textContent = 'Guardando cambios...';
                    }
                });
            }

            verificarCambiosEdit();
        });
    </script>
}
