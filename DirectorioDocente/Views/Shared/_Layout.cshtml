                                    class="py-2 px-3 bg-[#0F9F83] hover:bg-[#0D876F] text-white rounded-md text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs disabled:opacity-40 disabled:cursor-not-allowed">
                                <icon name="check" class="w-3.5 h-3.5 text-white" />
                                <span id="btnRevAprobarTexto">Aprobar Entrega</span>
                            </button>

                            <button type="button" id="btnRevRegresar" onclick="ejecutarAccionRevision('regresar')"
                                    class="py-2 px-3 bg-[#D97745] hover:bg-[#C26535] text-white rounded-md text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs disabled:opacity-40 disabled:cursor-not-allowed">
                                <icon name="rotate-ccw" class="w-3.5 h-3.5 text-white" />
                                <span id="btnRevRegresarTexto">Regresar a Revisión</span>
                            </button>
                        </div>

                        <div class="flex items-center justify-end pt-1">
                            <button type="button" id="btnRevEliminar" onclick="ejecutarEliminarDesdeRevision()"
                                    class="text-xs text-[#C2414B] hover:underline font-semibold inline-flex items-center gap-1 disabled:opacity-40 disabled:cursor-not-allowed">
                                <icon name="trash-2" class="w-3 h-3 text-[#C2414B]" />
                                <span>Eliminar actividad</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </dialog>

    <dialog id="modalReporteMensual" closedby="any" aria-labelledby="repTituloModal" class="w-full max-w-md rounded-lg select-none">
        <div id="modalReporteContenido" class="bg-white w-full rounded-lg shadow-xl border border-[#DCE4ED] overflow-hidden">
            <div class="px-5 py-3.5 bg-[#172B4D] text-white flex justify-between items-center">
                <div class="flex items-center gap-2.5">
                    <icon name="calendar" class="w-4 h-4 text-white" />
                    <div>
                        <h3 id="repTituloModal" class="font-bold text-sm text-white">Exportar Reporte Mensual</h3>
                        <p class="text-[11px] text-slate-300">Evidencias y cumplimiento por periodo</p>
                    </div>
                </div>
                <button type="button" onclick="cerrarModalReporteMensual()" aria-label="Cerrar ventana de reporte mensual" class="modal-close-btn text-slate-300 hover:text-white hover:bg-white/10 text-2xl leading-none">&times;</button>
            </div>

            <form asp-controller="Docentes" asp-action="DescargarReporteMensual" method="get" class="p-5 space-y-4 text-xs">
                <div>
                    <label for="repAnio" class="block font-bold text-[#172B4D] mb-1">Año del periodo</label>
                    <select name="anio" id="repAnio" class="w-full px-3 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] outline-none">
                        <option value="@DateTime.Now.Year" selected>@DateTime.Now.Year (Actual)</option>
                        <option value="@(DateTime.Now.Year - 1)">@(DateTime.Now.Year - 1)</option>
                    </select>
                </div>

                <div>
                    <label for="repMes" class="block font-bold text-[#172B4D] mb-1">Mes a exportar</label>
                    <select name="mes" id="repMes" class="w-full px-3 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] outline-none">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var fechaMes = new DateTime(2026, m, 1);
                            var nombreMes = fechaMes.ToString("MMMM", new System.Globalization.CultureInfo("es-MX"));
                            var esMesActual = (m == DateTime.Now.Month);
                            if (esMesActual)
                            {
                                <option value="@m" selected>@char.ToUpper(nombreMes[0])@nombreMes.Substring(1)</option>
                            }
                            else
                            {
                                <option value="@m">@char.ToUpper(nombreMes[0])@nombreMes.Substring(1)</option>
                            }
                        }
                    </select>
                </div>

                <div class="p-3 bg-[#E9EFF6] border border-[#DCE4ED] rounded-md text-[#172B4D] space-y-1">
                    <p class="font-bold text-xs">Formato Excel UTF-8 (.CSV)</p>
                    <p class="text-[11px] text-[#64748B]">Incluye matrícula, docente, título, estatus de entrega, fechas y comentarios de dirección.</p>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t border-[#DCE4ED]">
                    <button type="button" onclick="cerrarModalReporteMensual()"
                            class="px-4 py-2 border border-[#DCE4ED] rounded-md text-[#64748B] hover:bg-slate-100 font-semibold transition text-xs">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#285EA8] hover:bg-[#172B4D] text-white rounded-md font-bold transition shadow-xs text-xs">
                        <icon name="download" class="w-3.5 h-3.5 text-white" />
                        <span>Descargar Reporte</span>
                    </button>
                </div>
            </form>
        </div>
    </dialog>

    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="globalCsrfForm" class="hidden">@Html.AntiForgeryToken()</form>
    }

    <script>
        function initGsapDropdowns() {
            document.querySelectorAll('.dropdown-wrap').forEach(wrap => {
                const trigger = wrap.querySelector('.dropdown-trigger');
                const menu    = wrap.querySelector('.dropdown-menu');
                const arrow   = wrap.querySelector('.dd-arrow');
                const items   = wrap.querySelectorAll('.dropdown-item');

                if (!trigger || !menu) return;

                if (wrap.dataset.gsapBound) return;
                wrap.dataset.gsapBound = "true";

                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = menu.classList.contains('open');

                    cerrarTodosLosDropdowns();

                    if (!isOpen) {
                        menu.classList.add('open');
                        if (arrow) gsap.to(arrow, { rotation: 180, duration: 0.22, ease: 'power2.out' });
                        gsap.fromTo(menu,
                            { opacity: 0, y: -8, scale: 0.98 },
                            { opacity: 1, y: 0, scale: 1, duration: 0.22, ease: 'power2.out', clearProps: 'transform' }
                        );
                        if (items.length > 0) {
                            gsap.fromTo(items,
                                { opacity: 0, y: -4 },
                                { opacity: 1, y: 0, duration: 0.15, stagger: 0.03, ease: 'power2.out', clearProps: 'transform,opacity' }
                            );
                        }
                    }
                });
            });

            document.addEventListener('click', () => {
                cerrarTodosLosDropdowns();
            });
        }

        function cerrarTodosLosDropdowns() {
            document.querySelectorAll('.dropdown-menu.open').forEach(menu => {
                const wrap = menu.closest('.dropdown-wrap');
                const arrow = wrap ? wrap.querySelector('.dd-arrow') : null;
                if (arrow) gsap.to(arrow, { rotation: 0, duration: 0.16, ease: 'power2.out' });
                gsap.to(menu, {
                    opacity: 0,
                    y: -8,
                    scale: 0.98,
                    duration: 0.15,
                    ease: 'power2.out',
                    onComplete: () => menu.classList.remove('open')
                });
            });
        }

        const prefiereMovimientoReducido = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function initSidebar() {
            if (typeof gsap !== 'undefined') {
                gsap.defaults({ overwrite: 'auto' });
            }

            const sidebar = document.getElementById('mainSidebar');
            if (!sidebar) return;

            const isCollapsed = localStorage.getItem('siged_sidebar_collapsed') === 'true';
            if (isCollapsed && window.innerWidth >= 1024) {
                sidebar.classList.add('sidebar-collapsed');
            }

            if (window.innerWidth >= 1024 && typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                gsap.fromTo('.sidebar-nav-item',
                    { opacity: 0, x: -6 },
                    { opacity: 1, x: 0, duration: 0.24, stagger: 0.025, ease: 'power3.out', clearProps: 'opacity,transform' }
                );
            }

            initGsapDropdowns();
        }

        function toggleSidebarDesktop() {
            const sidebar = document.getElementById('mainSidebar');
            if (!sidebar) return;

            const willCollapse = !sidebar.classList.contains('sidebar-collapsed');
            if (willCollapse) {
                sidebar.classList.add('sidebar-collapsed');
                localStorage.setItem('siged_sidebar_collapsed', 'true');
            } else {
                sidebar.classList.remove('sidebar-collapsed');
                localStorage.setItem('siged_sidebar_collapsed', 'false');
                if (typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                    gsap.fromTo('.sidebar-label',
                        { opacity: 0 },
                        { opacity: 1, duration: 0.18, ease: 'power2.out', clearProps: 'opacity' }
                    );
                }
            }
        }

        function toggleSidebarMobile() {
            const sidebar = document.getElementById('mainSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (!sidebar || !backdrop) return;

            const isHidden = sidebar.classList.contains('-translate-x-full');
            if (isHidden) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
                if (typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                    gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.2, ease: 'power2.out' });
                    gsap.fromTo(sidebar, { xPercent: -100 }, { xPercent: 0, duration: 0.24, ease: 'power3.out', clearProps: 'transform' });
                }
            } else {
                if (typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                    gsap.to(backdrop, { opacity: 0, duration: 0.16, ease: 'power2.out' });
                    gsap.to(sidebar, {
                        xPercent: -100,
                        duration: 0.18,
                        ease: 'power3.out',
                        onComplete: () => {
                            gsap.set(sidebar, { clearProps: 'transform' });
                            gsap.set(backdrop, { clearProps: 'opacity' });
                            sidebar.classList.add('-translate-x-full');
                            backdrop.classList.add('hidden');
                        }
                    });
                } else {
                    sidebar.classList.add('-translate-x-full');
                    backdrop.classList.add('hidden');
                }
            }
        }

        let domPurifyPromise;
        function loadDOMPurify() {
            domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then((mod) => mod.default ?? mod);
            return domPurifyPromise;
        }

        async function safeSetHTML(el, html) {
            const elements = ['p', 'b', 'i', 'strong', 'em', 'span'];
            const attributes = ['class'];
            if ('setHTML' in Element.prototype) {
                el.setHTML(html, { sanitizer: { elements, attributes } });
            } else {
                const DOMPurify = await loadDOMPurify();
                el.innerHTML = DOMPurify.sanitize(html, {
                    ALLOWED_TAGS: [...elements, '#text'],
                    ALLOWED_ATTR: attributes,
                    ALLOW_ARIA_ATTR: false,
                    ALLOW_DATA_ATTR: false,
                    KEEP_CONTENT: false
                });
            }
        }

        function abrirDialogoModal(dialog, contenido) {
            if (!dialog) return;
            if (!dialog.open) {
                dialog.showModal();
            }
            if (contenido && typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                gsap.fromTo(contenido, { opacity: 0, scale: 0.96, y: -8 }, { opacity: 1, scale: 1, y: 0, duration: 0.2, ease: 'power3.out', clearProps: 'transform,opacity' });
            }
        }

        function cerrarDialogoModal(dialog, contenido, onComplete) {
            if (!dialog || !dialog.open) return;
            if (contenido && typeof gsap !== 'undefined' && !prefiereMovimientoReducido()) {
                gsap.to(contenido, {
                    opacity: 0,
                    scale: 0.97,
                    y: -6,
                    duration: 0.14,
                    ease: 'power2.out',
                    onComplete: () => {
                        dialog.close();
                        gsap.set(contenido, { clearProps: 'opacity,transform' });
                        if (typeof onComplete === 'function') onComplete();
                    }
                });
            } else {
                dialog.close();
                if (typeof onComplete === 'function') onComplete();
            }
        }

        function initDialogLightDismissFallback() {
            for (const dialog of document.querySelectorAll('dialog')) {
                dialog.addEventListener('close', () => {
                    dialog.returnValue = '';
                    if (dialog.id === 'modalRevision') {
                        const iframe = document.getElementById('revIframe');
                        if (iframe) iframe.src = '';
                        actividadRevisionActualId = null;
                    }
                });
            }

            if (!('closedBy' in HTMLDialogElement.prototype)) {
                const outside = (e, dialog) => {
                    const r = dialog.getBoundingClientRect();
                    return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
                };
                for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
                    let pressedOutside = false;
                    dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
                    dialog.addEventListener('pointerup', (e) => {
                        if (pressedOutside && outside(e, dialog)) {
                            if (typeof dialog._onLightDismiss === 'function') dialog._onLightDismiss();
                            else dialog.close();
                        }
                    });
                }
            }
        }

        function abrirModalReporteMensual() {
            const modal = document.getElementById('modalReporteMensual');
            const contenido = document.getElementById('modalReporteContenido');
            abrirDialogoModal(modal, contenido);
        }

        function cerrarModalReporteMensual() {
            const modal = document.getElementById('modalReporteMensual');
            const contenido = document.getElementById('modalReporteContenido');
            cerrarDialogoModal(modal, contenido);
        }

        function abrirModalAsignarGlobal() {
            if (typeof abrirModalAsignar === 'function') {
                abrirModalAsignar();
            } else {
                window.location.href = '/Docentes/Index?openAssign=1';
            }
        }

        let actividadRevisionActualId = null;

        function verificarTextoRevisionChat() {
            const input = document.getElementById('revNuevoMensaje');
            const btn = document.getElementById('btnRevEnviarMsg');
            if (!input || !btn) return;
            const tieneTexto = input.value.trim().length > 0;
            btn.disabled = !tieneTexto;
            if (tieneTexto) {
                btn.classList.remove('opacity-40', 'cursor-not-allowed');
            } else {
                btn.classList.add('opacity-40', 'cursor-not-allowed');
            }
        }

        async function abrirModalRevision(actividadId) {
            actividadRevisionActualId = actividadId;
            const modal = document.getElementById('modalRevision');
            const contenido = document.getElementById('modalRevisionContenido');
            if (!modal || !contenido) return;

            document.getElementById('revTitulo').textContent = 'Cargando información...';
            document.getElementById('revDocente').textContent = '';
            document.getElementById('revIframe').classList.add('hidden');
            document.getElementById('revIframe').src = '';
            document.getElementById('revSinDocs').classList.remove('hidden');
            document.getElementById('btnRevAbrirPestana').classList.add('hidden');
            document.getElementById('btnRevDescargar').classList.add('hidden');
            document.getElementById('revChatHistorial').innerHTML = '<p class="text-center text-slate-400 italic text-[11px] py-4">Cargando comentarios...</p>';
            
            const chatInput = document.getElementById('revNuevoMensaje');
            if (chatInput) chatInput.value = '';
            verificarTextoRevisionChat();

            const btnAprobar = document.getElementById('btnRevAprobar');
            const btnRegresar = document.getElementById('btnRevRegresar');
            const btnEliminar = document.getElementById('btnRevEliminar');

            if (btnAprobar) {
                btnAprobar.disabled = false;
                btnAprobar.classList.remove('opacity-40', 'cursor-not-allowed');
                btnAprobar.title = 'Aprobar entrega de evidencia';
                const txt = document.getElementById('btnRevAprobarTexto');
                if (txt) txt.textContent = 'Aprobar Entrega';
            }
            if (btnRegresar) {
                btnRegresar.disabled = false;
                btnRegresar.classList.remove('opacity-40', 'cursor-not-allowed');
                btnRegresar.title = 'Regresar al docente para correcciones';
                const txt = document.getElementById('btnRevRegresarTexto');
                if (txt) txt.textContent = 'Regresar a Revisión';
            }
            if (btnEliminar) {
                btnEliminar.disabled = false;
                btnEliminar.classList.remove('opacity-40', 'cursor-not-allowed');
            }

            abrirDialogoModal(modal, contenido);

            try {
                const resp = await fetch(`/Docentes/GetDetalleActividad?id=${actividadId}`);
                const data = await resp.json();
                if (!data.success) {
                    alert('No se pudo cargar la actividad.');
                    cerrarModalRevision();
                    return;
                }

                document.getElementById('revTitulo').textContent = data.titulo;
                document.getElementById('revDocente').textContent = `${data.docenteNombre} (${data.docenteClave}) · ${data.docenteContrato}`;
                document.getElementById('revFechaLimite').textContent = data.fechaLimite;
                document.getElementById('revFechaCumplimiento').textContent = data.fechaCumplimiento || 'Pendiente';

                const badge = document.getElementById('revBadgeEstatus');
                badge.textContent = data.estatus;
                if (data.estatus === 'Cumplido') {
                    badge.className = 'px-2 py-0.5 rounded-sm text-xs font-bold bg-emerald-50 text-[#0F9F83] border border-[#0F9F83]/30';
                    if (btnAprobar) {
                        btnAprobar.disabled = true;
                        btnAprobar.classList.add('opacity-40', 'cursor-not-allowed');
                        btnAprobar.title = 'Esta actividad ya ha sido aprobada y marcada como cumplida';
                    }
                } else if (data.estatus === 'En revision') {
                    badge.className = 'px-2 py-0.5 rounded-sm text-xs font-bold bg-blue-50 text-[#285EA8] border border-[#285EA8]/30';
                } else {
                    badge.className = 'px-2 py-0.5 rounded-sm text-xs font-bold bg-amber-50 text-[#D97745] border border-[#D97745]/30';
                    if (btnRegresar) {
                        btnRegresar.disabled = true;
                        btnRegresar.classList.add('opacity-40', 'cursor-not-allowed');
                        btnRegresar.title = 'La actividad aún se encuentra en estatus pendiente de entrega';
                    }
                }

                const tabsCont = document.getElementById('revDocTabs');
                tabsCont.innerHTML = '';
                if (data.documentos && data.documentos.length > 0) {
                    tabsCont.classList.remove('hidden');
                    data.documentos.forEach((doc, idx) => {
                        const btnTab = document.createElement('button');
                        btnTab.type = 'button';
                        btnTab.className = `px-2 py-1 rounded-sm text-xs font-bold truncate max-w-[150px] transition ${idx === 0 ? 'bg-[#285EA8] text-white shadow-xs' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 border border-[#DCE4ED]'}`;
                        btnTab.textContent = doc.nombreOriginal;
                        btnTab.onclick = () => seleccionarDocumentoRevision(doc, btnTab);
                        tabsCont.appendChild(btnTab);
                    });
                    seleccionarDocumentoRevision(data.documentos[0], tabsCont.children[0]);
                } else {
                    tabsCont.classList.add('hidden');
                    document.getElementById('revIframe').classList.add('hidden');
                    document.getElementById('revSinDocs').classList.remove('hidden');
                }

                renderizarComentariosRevision(data.comentarios || []);
            } catch (err) {
                alert('Error al obtener los detalles de la actividad.');
            }
        }

        function renderizarComentariosRevision(comentarios) {
            const chatCont = document.getElementById('revChatHistorial');
            const chatCount = document.getElementById('revChatCount');
            chatCount.textContent = `${comentarios.length} mensaje(s)`;

            if (!comentarios || comentarios.length === 0) {
                chatCont.innerHTML = '<p class="text-center text-slate-400 italic text-[11px] py-4">No hay observaciones previas registradas.</p>';
                return;
            }

            chatCont.innerHTML = '';
            comentarios.forEach(c => {
                const esDirector = c.rolAutor === 'Administrador';
                const msgDiv = document.createElement('div');
                msgDiv.className = `flex flex-col ${esDirector ? 'items-start' : 'items-end'} space-y-0.5`;

                const metaDiv = document.createElement('div');
                metaDiv.className = 'flex items-center gap-1.5 text-[10px]';

                const autorSpan = document.createElement('span');
                autorSpan.className = `font-bold ${esDirector ? 'text-[#172B4D]' : 'text-[#0F9F83]'}`;
                autorSpan.textContent = c.autorNombre ?? '';

                const fechaSpan = document.createElement('span');
                fechaSpan.className = 'text-slate-400';
                fechaSpan.textContent = c.fecha ?? '';

                metaDiv.append(autorSpan, fechaSpan);

                const bodyDiv = document.createElement('div');
                bodyDiv.className = `p-2 rounded-md max-w-[90%] text-xs ${esDirector ? 'bg-[#E9EFF6] text-[#172B4D] border border-[#DCE4ED]' : 'bg-emerald-50 text-emerald-950 border border-[#0F9F83]/30'}`;
                bodyDiv.textContent = c.mensaje ?? '';

                msgDiv.append(metaDiv, bodyDiv);
                chatCont.appendChild(msgDiv);
            });

            chatCont.scrollTop = chatCont.scrollHeight;
        }

        async function enviarMensajeRevision() {
            if (!actividadRevisionActualId) return;
            const input = document.getElementById('revNuevoMensaje');
            const btn = document.getElementById('btnRevEnviarMsg');
            const txt = document.getElementById('btnRevEnviarMsgTexto');
            const texto = input.value.trim();
            if (!texto) return;

            if (btn) {
                btn.disabled = true;
                btn.classList.add('opacity-40', 'cursor-not-allowed');
                if (txt) txt.textContent = 'Enviando...';
            }

            try {
                const resp = await fetch('/Docentes/AgregarComentario', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ actividadId: actividadRevisionActualId, mensaje: texto })
                });
                const res = await resp.json();
                if (res.success) {
                    input.value = '';
                    verificarTextoRevisionChat();
                    const r = await fetch(`/Docentes/GetDetalleActividad?id=${actividadRevisionActualId}`);
                    const d = await r.json();
                    if (d.success) renderizarComentariosRevision(d.comentarios || []);
                } else {
                    alert(res.message || 'Error al enviar mensaje');
                }
            } catch {
                alert('Error al conectar con el servidor.');
            } finally {
                if (txt) txt.textContent = 'Enviar';
                verificarTextoRevisionChat();
            }
        }

        function seleccionarDocumentoRevision(doc, btnActivo) {
            const tabs = document.querySelectorAll('#revDocTabs button');
            tabs.forEach(t => {
                t.className = 'px-2 py-1 rounded-sm text-xs font-bold truncate max-w-[150px] bg-slate-100 text-slate-700 hover:bg-slate-200 border border-[#DCE4ED] transition';
            });
            if (btnActivo) {
                btnActivo.className = 'px-2 py-1 rounded-sm text-xs font-bold truncate max-w-[150px] bg-[#285EA8] text-white shadow-xs transition';
            }

            const iframe = document.getElementById('revIframe');
            const sinDocs = document.getElementById('revSinDocs');
            const btnAbrir = document.getElementById('btnRevAbrirPestana');
            const btnDesc = document.getElementById('btnRevDescargar');

            btnAbrir.href = doc.previewUrl;
            btnAbrir.classList.remove('hidden');
            btnDesc.href = doc.downloadUrl;
            btnDesc.classList.remove('hidden');

            if (doc.esPrevisualizable) {
                iframe.src = doc.previewUrl;
                iframe.classList.remove('hidden');
                sinDocs.classList.add('hidden');
            } else {
                iframe.src = '';
                iframe.classList.add('hidden');
                sinDocs.classList.remove('hidden');
                sinDocs.querySelector('p').textContent = `Archivo descargable: ${doc.nombreOriginal}`;
            }
        }

        function cerrarModalRevision() {
            const modal = document.getElementById('modalRevision');
            const contenido = document.getElementById('modalRevisionContenido');
            cerrarDialogoModal(modal, contenido, () => {
                document.getElementById('revIframe').src = '';
                actividadRevisionActualId = null;
            });
        }

        async function ejecutarAccionRevision(accion) {
            if (!actividadRevisionActualId) return;
            const nuevoMsg = document.getElementById('revNuevoMensaje').value.trim();

            const btnAprobar = document.getElementById('btnRevAprobar');
            const btnRegresar = document.getElementById('btnRevRegresar');
            const btnEliminar = document.getElementById('btnRevEliminar');

            if (btnAprobar) {
                btnAprobar.disabled = true;
                btnAprobar.classList.add('opacity-40', 'cursor-not-allowed');
                if (accion === 'aprobar') {
                    const txt = document.getElementById('btnRevAprobarTexto');
                    if (txt) txt.textContent = 'Aprobando...';
                }
            }
            if (btnRegresar) {
                btnRegresar.disabled = true;
                btnRegresar.classList.add('opacity-40', 'cursor-not-allowed');
                if (accion === 'regresar') {
                    const txt = document.getElementById('btnRevRegresarTexto');
                    if (txt) txt.textContent = 'Regresando...';
                }
            }
            if (btnEliminar) {
                btnEliminar.disabled = true;
                btnEliminar.classList.add('opacity-40', 'cursor-not-allowed');
            }

            try {
                const resp = await fetch('/Docentes/RevisarActividad', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        actividadId: actividadRevisionActualId,
                        accion: accion,
                        comentario: nuevoMsg
                    })
                });
                const res = await resp.json();
                if (res.success) {
                    cerrarModalRevision();
                    window.location.reload();
                } else {
                    alert(res.message || 'Error al procesar la revisión.');
                    if (btnAprobar) {
                        btnAprobar.disabled = false;
                        btnAprobar.classList.remove('opacity-40', 'cursor-not-allowed');
                        const txt = document.getElementById('btnRevAprobarTexto');
                        if (txt) txt.textContent = 'Aprobar Entrega';
                    }
                    if (btnRegresar) {
                        btnRegresar.disabled = false;
                        btnRegresar.classList.remove('opacity-40', 'cursor-not-allowed');
                        const txt = document.getElementById('btnRevRegresarTexto');
                        if (txt) txt.textContent = 'Regresar a Revisión';
                    }
                    if (btnEliminar) {
                        btnEliminar.disabled = false;
                        btnEliminar.classList.remove('opacity-40', 'cursor-not-allowed');
                    }
                }
            } catch {
                alert('Error de conexión al guardar la revisión.');
                if (btnAprobar) {
                    btnAprobar.disabled = false;
                    btnAprobar.classList.remove('opacity-40', 'cursor-not-allowed');
                    const txt = document.getElementById('btnRevAprobarTexto');
                    if (txt) txt.textContent = 'Aprobar Entrega';
                }
                if (btnRegresar) {
                    btnRegresar.disabled = false;
                    btnRegresar.classList.remove('opacity-40', 'cursor-not-allowed');
                    const txt = document.getElementById('btnRevRegresarTexto');
                    if (txt) txt.textContent = 'Regresar a Revisión';
                }
                if (btnEliminar) {
                    btnEliminar.disabled = false;
                    btnEliminar.classList.remove('opacity-40', 'cursor-not-allowed');
                }
            }
        }

        async function ejecutarEliminarDesdeRevision() {
            if (!actividadRevisionActualId) return;
            const titulo = document.getElementById('revTitulo').textContent;
            if (!confirm(`¿Eliminar la actividad "${titulo}"? Se eliminarán también sus documentos adjuntos.`)) return;

            const btnEliminar = document.getElementById('btnRevEliminar');
            const btnAprobar = document.getElementById('btnRevAprobar');
            const btnRegresar = document.getElementById('btnRevRegresar');

            if (btnEliminar) {
                btnEliminar.disabled = true;
                btnEliminar.classList.add('opacity-40', 'cursor-not-allowed');
            }
            if (btnAprobar) {
                btnAprobar.disabled = true;
                btnAprobar.classList.add('opacity-40', 'cursor-not-allowed');
            }
            if (btnRegresar) {
                btnRegresar.disabled = true;
                btnRegresar.classList.add('opacity-40', 'cursor-not-allowed');
            }

            try {
                const resp = await fetch(`/Docentes/EliminarActividad?id=${actividadRevisionActualId}`, { method: 'POST' });
                const res = await resp.json();
                if (res.success) {
                    cerrarModalRevision();
                    window.location.reload();
                } else {
                    alert(res.message || 'Error al eliminar.');
                    if (btnEliminar) {
                        btnEliminar.disabled = false;
                        btnEliminar.classList.remove('opacity-40', 'cursor-not-allowed');
                    }
                }
            } catch {
                alert('Error al conectar con el servidor.');
                if (btnEliminar) {
                    btnEliminar.disabled = false;
                    btnEliminar.classList.remove('opacity-40', 'cursor-not-allowed');
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initSidebar();
            initDialogLightDismissFallback();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>