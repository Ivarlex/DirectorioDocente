@model DirectorioDocente.Models.LoginViewModel

@{
    ViewData["Title"] = "Acceso al Sistema";
    Layout = "_Layout";
}

<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none select-none bg-[#172B4D]" aria-hidden="true">
    <img id="loginBgSlide1"
         src="~/assets/img/upvm.png"
         alt=""
         decoding="async"
         class="absolute inset-0 w-full h-full object-cover opacity-100 will-change-transform" />
    <img id="loginBgSlide2"
         src="~/assets/img/imgupvm.jpeg"
         alt=""
         decoding="async"
         class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" />

    <div class="absolute inset-0 bg-gradient-to-br from-[#172B4D]/80 via-[#172B4D]/65 to-[#0F172A]/80"></div>
</div>

<div class="relative z-10 min-h-[calc(100svh-120px)] flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-sm">

        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-white text-[#172B4D] shadow-md mb-3">
                <icon name="graduation-cap" class="w-6 h-6 text-[#172B4D]" />
            </div>
            <h1 class="text-xl font-bold text-white drop-shadow-xs">SIGED · UPVM</h1>
            <p class="text-xs text-slate-200 mt-0.5">Sistema Integral de Gestión Docente</p>
        </div>

        <div class="bg-white/95 backdrop-blur-sm rounded-lg border border-white/20 shadow-xl overflow-hidden">

            <div class="bg-[#172B4D] px-5 py-3 border-b border-white/10">
                <p class="text-[10px] text-slate-300 text-center uppercase tracking-wider font-bold">Portal de Acceso Unificado</p>
                <div class="flex justify-center gap-4 mt-1.5 text-xs font-semibold">
                    <span class="flex items-center gap-1.5 text-slate-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#285EA8]"></span>
                        Dirección
                    </span>
                    <span class="flex items-center gap-1.5 text-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#0F9F83]"></span>
                        Cuerpo Docente
                    </span>
                </div>
            </div>

            <form asp-action="Login" method="post" class="p-5 space-y-3.5 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="flex items-start gap-2 p-2.5 bg-rose-50 border border-[#C2414B]/30 rounded-md text-xs text-[#C2414B]">
                        <icon name="triangle-alert" class="w-4 h-4 text-[#C2414B] shrink-0 mt-0.5" />
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div>
                    <label asp-for="NombreUsuario" class="block font-bold text-[#172B4D] mb-1">Matrícula / Nombre de Usuario</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#64748B]">
                            <icon name="users" class="w-3.5 h-3.5 text-[#64748B]" />
                        </span>
                        <input asp-for="NombreUsuario"
                               placeholder="Ej. D-101 o director"
                               autocomplete="username"
                               class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] focus:bg-white outline-none transition" />
                    </div>
                    <span asp-validation-for="NombreUsuario" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label asp-for="Password" class="font-bold text-[#172B4D]">Contraseña</label>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#64748B]">
                            <icon name="lock-keyhole" class="w-3.5 h-3.5 text-[#64748B]" />
                        </span>
                        <input asp-for="Password"
                               type="password"
                               placeholder="Contraseña institucional"
                               autocomplete="current-password"
                               class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] focus:bg-white outline-none transition" />
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
                </div>

                <label class="touch-target justify-start gap-2.5 cursor-pointer select-none py-1.5">
                    <input asp-for="Recordarme" type="checkbox"
                           class="w-4 h-4 rounded-xs border-[#DCE4ED] accent-[#285EA8] cursor-pointer" />
                    <span class="text-xs text-[#64748B]">Mantener sesión iniciada</span>
                </label>

                <button type="submit"
                        class="w-full py-2.5 bg-[#285EA8] hover:bg-[#172B4D] text-white text-xs font-bold rounded-md transition shadow-xs flex items-center justify-center gap-1.5">
                    <icon name="log-in" class="w-3.5 h-3.5 text-white" />
                    <span>Ingresar al Sistema</span>
                </button>
            </form>
        </div>

        <div class="mt-4 p-3 bg-white/95 backdrop-blur-sm rounded-lg border border-white/20 shadow-md text-[11px] text-[#64748B] space-y-0.5">
            <p class="font-bold text-[#172B4D]">¿Primer acceso o nuevo docente?</p>
            <p>Utiliza la matrícula asignada por la Dirección Académica o solicita tu enlace de registro.</p>
        </div>

    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slide1 = document.getElementById('loginBgSlide1');
        const slide2 = document.getElementById('loginBgSlide2');
        if (!slide1 || !slide2 || typeof gsap === 'undefined') return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            gsap.set(slide1, { opacity: 1, scale: 1.02 });
            gsap.set(slide2, { opacity: 0 });
            return;
        }

        const duracionImagen = 10;
        const duracionCrossfade = 1.6;

        gsap.set(slide1, { opacity: 1, scale: 1.06, xPercent: -2, yPercent: -1 });
        gsap.set(slide2, { opacity: 0, scale: 1.14, xPercent: 2, yPercent: 1.5 });

        const tl = gsap.timeline({ repeat: -1 });

        tl.to(slide1, {
            scale: 1.14,
            xPercent: 2,
            yPercent: 1.5,
            duration: duracionImagen,
            ease: 'none'
        }, 0);

        tl.to(slide1, {
            opacity: 0,
            duration: duracionCrossfade,
            ease: 'power1.inOut'
        }, duracionImagen - duracionCrossfade);

        tl.to(slide2, {
            opacity: 1,
            duration: duracionCrossfade,
            ease: 'power1.inOut'
        }, duracionImagen - duracionCrossfade);

        const inicioSlide2 = duracionImagen - duracionCrossfade;
        tl.fromTo(slide2,
            { scale: 1.14, xPercent: 2, yPercent: 1.5 },
            {
                scale: 1.06,
                xPercent: -2,
                yPercent: -1.5,
                duration: duracionImagen,
                ease: 'none'
            },
            inicioSlide2
        );

        tl.set(slide1, { scale: 1.06, xPercent: -2, yPercent: -1 }, inicioSlide2 + duracionCrossfade);

        const finSlide2 = inicioSlide2 + duracionImagen - duracionCrossfade;
        tl.to(slide2, {
            opacity: 0,
            duration: duracionCrossfade,
            ease: 'power1.inOut'
        }, finSlide2);

        tl.to(slide1, {
            opacity: 1,
            duration: duracionCrossfade,
            ease: 'power1.inOut'
        }, finSlide2);
    });
</script>
}
