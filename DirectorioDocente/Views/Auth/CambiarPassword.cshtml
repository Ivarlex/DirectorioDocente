@model DirectorioDocente.Models.CambiarPasswordViewModel

@{
    ViewData["Title"] = Model.EsObligatorio ? "Crear Contraseña Personal" : "Cambiar Contraseña";
    Layout = "_Layout";
}

<div class="min-h-[calc(100svh-160px)] flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-sm">

        @if (Model.EsObligatorio)
        {
            <div class="mb-4 flex items-start gap-2.5 p-3.5 bg-amber-50 border border-amber-200 rounded-lg">
                <icon name="key-round" class="w-4 h-4 text-[#D97745] shrink-0 mt-0.5" />
                <div>
                    <p class="text-xs font-bold text-amber-900">Contraseña temporal asignada</p>
                    <p class="text-[11px] text-amber-800 mt-0.5">
                        Por seguridad debes establecer tu contraseña personal antes de continuar al sistema.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="text-center mb-5">
                <h1 class="text-lg font-bold text-[#172B4D]">Cambiar Contraseña</h1>
                <p class="text-xs text-[#64748B]">Actualiza tu clave de acceso institucional</p>
            </div>
        }

        <div class="bg-white rounded-lg border border-[#DCE4ED] shadow-sm overflow-hidden">

            <div class="bg-[#172B4D] px-5 py-3 border-b border-white/10">
                <p class="text-xs text-slate-300 text-center">
                    Usuario: <span class="text-white font-mono font-bold">@User.Identity?.Name</span>
                </p>
            </div>

            <form asp-action="CambiarPassword" method="post" class="p-5 space-y-3.5 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EsObligatorio" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="flex items-start gap-2 p-2.5 bg-rose-50 border border-[#C2414B]/30 rounded-md text-xs text-[#C2414B]">
                        <icon name="triangle-alert" class="w-4 h-4 text-[#C2414B] shrink-0 mt-0.5" />
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                @if (!Model.EsObligatorio)
                {
                    <div>
                        <label asp-for="PasswordActual" class="block font-bold text-[#172B4D] mb-1">Contraseña Actual</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#64748B]">
                                <icon name="lock-keyhole" class="w-3.5 h-3.5 text-[#64748B]" />
                            </span>
                            <input asp-for="PasswordActual"
                                   type="password"
                                   placeholder="Tu contraseña actual"
                                   autocomplete="current-password"
                                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] outline-none transition" />
                        </div>
                        <span asp-validation-for="PasswordActual" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
                    </div>
                }

                <div>
                    <label for="inputNuevo" class="block font-bold text-[#172B4D] mb-1">Nueva Contraseña</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#64748B]">
                            <icon name="key-round" class="w-3.5 h-3.5 text-[#64748B]" />
                        </span>
                        <input asp-for="PasswordNuevo"
                               id="inputNuevo"
                               type="password"
                               aria-describedby="requisitos"
                               placeholder="Mínimo 6 caracteres"
                               autocomplete="new-password"
                               class="w-full pl-9 pr-9 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] outline-none transition"
                               oninput="evaluarFuerza(this.value)" />
                        <button type="button" onclick="toggleVer('inputNuevo', this)"
                                aria-label="Mostrar u ocultar nueva contraseña"
                                class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-[#64748B] hover:text-[#172B4D]">
                            <icon name="eye" class="w-3.5 h-3.5" />
                        </button>
                    </div>
                    <span asp-validation-for="PasswordNuevo" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>

                    <div class="mt-2 space-y-1" id="fuerzaContainer">
                        <div class="flex gap-1">
                            <div class="h-1 flex-1 rounded-full bg-slate-200 transition-colors" id="barra1"></div>
                            <div class="h-1 flex-1 rounded-full bg-slate-200 transition-colors" id="barra2"></div>
                            <div class="h-1 flex-1 rounded-full bg-slate-200 transition-colors" id="barra3"></div>
                            <div class="h-1 flex-1 rounded-full bg-slate-200 transition-colors" id="barra4"></div>
                        </div>
                        <p id="fuerzaTexto" class="text-[10px] text-[#64748B]" aria-live="polite"></p>
                    </div>

                    <ul class="mt-2 space-y-0.5 text-[11px] text-[#64748B]" id="requisitos">
                        <li id="req-len"  class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Mínimo 6 caracteres</li>
                        <li id="req-num"  class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Al menos un número</li>
                        <li id="req-diff" class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Diferente a tu matrícula</li>
                    </ul>
                </div>

                <div>
                    <label for="inputConfirmar" class="block font-bold text-[#172B4D] mb-1">Confirmar Nueva Contraseña</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#64748B]">
                            <icon name="check" class="w-3.5 h-3.5 text-[#64748B]" />
                        </span>
                        <input asp-for="ConfirmarPassword"
                               id="inputConfirmar"
                               type="password"
                               placeholder="Repite la contraseña"
                               autocomplete="new-password"
                               class="w-full pl-9 pr-9 py-2 text-xs bg-slate-50 border border-[#DCE4ED] rounded-md focus:ring-1 focus:ring-[#285EA8] outline-none transition"
                               oninput="verificarCoincidencia()" />
                        <button type="button" onclick="toggleVer('inputConfirmar', this)"
                                aria-label="Mostrar u ocultar confirmación de contraseña"
                                class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-[#64748B] hover:text-[#172B4D]">
                            <icon name="eye" class="w-3.5 h-3.5" />
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmarPassword" class="text-[11px] text-[#C2414B] mt-0.5 block"></span>
                    <p id="matchMsg" class="text-[11px] mt-0.5 hidden" aria-live="polite"></p>
                </div>

                <div class="flex flex-col gap-2 pt-2">
                    <button type="submit" id="btnGuardar"
                            class="w-full py-2 bg-[#285EA8] hover:bg-[#172B4D] text-white text-xs font-bold rounded-md active:scale-95 transition shadow-xs flex items-center justify-center gap-1.5">
                        <icon name="lock-keyhole" class="w-3.5 h-3.5 text-white" />
                        <span>Guardar Contraseña</span>
                    </button>
                    @if (!Model.EsObligatorio)
                    {
                        <a asp-controller="Docentes" asp-action="@(User.IsInRole("Administrador") ? "Index" : "MisActividades")"
                           class="text-center text-xs text-[#64748B] hover:text-[#172B4D] transition">
                            Cancelar y volver
                        </a>
                    }
                </div>
            </form>
        </div>

        @if (Model.EsObligatorio)
        {
            <p class="text-center text-[11px] text-[#64748B] mt-3">
                Si requieres asistencia técnica, contacta a la Dirección Académica.
            </p>
        }
    </div>
</div>

@section Scripts {
<script>
    const matricula = '@User.Identity?.Name'.toLowerCase();

    function toggleVer(inputId, btn) {
        const input = document.getElementById(inputId);
        const esPass = input.type === 'password';
        input.type = esPass ? 'text' : 'password';
    }

    function evaluarFuerza(val) {
        const barras = [
            document.getElementById('barra1'),
            document.getElementById('barra2'),
            document.getElementById('barra3'),
            document.getElementById('barra4')
        ];
        const texto = document.getElementById('fuerzaTexto');

        const tieneLen  = val.length >= 6;
        const tieneNum  = /\d/.test(val);
        const esDiff    = val.toLowerCase() !== matricula;
        const tieneMay  = /[A-Z]/.test(val);
        const tieneEsp  = /[^a-zA-Z0-9]/.test(val);

        actualizarReq('req-len',  tieneLen);
        actualizarReq('req-num',  tieneNum);
        actualizarReq('req-diff', esDiff && val.length > 0);

        const nivel = [tieneLen, tieneNum, esDiff, tieneMay || tieneEsp].filter(Boolean).length;
        const colores = ['bg-slate-200', 'bg-rose-400', 'bg-amber-400', 'bg-yellow-400', 'bg-[#0F9F83]'];
        const labels  = ['', 'Muy débil', 'Débil', 'Aceptable', 'Fuerte'];

        barras.forEach((b, i) => {
            b.className = 'h-1 flex-1 rounded-full transition-colors ' + (i < nivel ? colores[nivel] : 'bg-slate-200');
        });
        texto.textContent = val.length > 0 ? labels[nivel] : '';
        texto.className   = 'text-[10px] ' + (['', 'text-[#C2414B]', 'text-[#D97745]', 'text-yellow-600', 'text-[#0F9F83]'][nivel] || 'text-[#64748B]');

        verificarCoincidencia();
    }

    function actualizarReq(id, ok) {
        const el = document.getElementById(id);
        if (!el) return;
        el.className = 'flex items-center gap-1.5 ' + (ok ? 'text-[#0F9F83] font-bold' : 'text-[#64748B]');
    }

    function verificarCoincidencia() {
        const nuevo     = document.getElementById('inputNuevo')?.value ?? '';
        const confirmar = document.getElementById('inputConfirmar')?.value ?? '';
        const msg       = document.getElementById('matchMsg');
        if (!msg || confirmar.length === 0) { msg.classList.add('hidden'); return; }
        msg.classList.remove('hidden');
        if (nuevo === confirmar) {
            msg.className = 'text-[11px] mt-0.5 text-[#0F9F83] font-bold';
            msg.textContent = '✓ Las contraseñas coinciden';
        } else {
            msg.className = 'text-[11px] mt-0.5 text-[#C2414B] font-bold';
            msg.textContent = '✕ Las contraseñas no coinciden';
        }
    }
</script>
}
